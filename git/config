[user]
    name = Michał 'Griwes' Dominiak
    email = griwes@griwes.info

[init]
    defaultBranch = main

[alias]
    d = difftool
    fix = commit --fixup
    mri = rebase -i
    ri = rebase -i --autosquash
    squ = commit --squash
    wtb = "!f() { git worktree add -b \"$1\" \"$1\" \"$2\"; }; f"
    wtc = "!f() { git worktree add \"$1\" \"$1\"; }; f"

[commit]
    gpgsign = true

[tag]
    gpgsign = true

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = /home/griwes/.ssh/allowed_signers
    defaultKeyCommand = bash -c 'ssh-add -L | xargs -I{} echo "key::{}"'

[credential "https://github.com"]
    helper =
    helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !/usr/bin/gh auth git-credential

[diff]
    external = difft
    tool = difftastic

[difftool]
    prompt = false

[difftool "difftastic"]
    # See `man git-difftool` for a description of MERGED, LOCAL and REMOTE.
    cmd = difft "$MERGED" "$LOCAL" "abcdef1" "100644" "$REMOTE" "abcdef2" "100644"

[merge]
    tool = codediff

[mergetool "codediff"]
    cmd = nvim "$MERGED" -c "CodeDiff merge \"$MERGED\""

[pager]
    difftool = true

[fetch]
    writeCommitGraph = true

[pull]
    ff = only

[push]
    default = simple

[rerere]
    enabled = true

# vim: ft=gitconfig
