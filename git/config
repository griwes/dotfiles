[user]
    name = Michał 'Griwes' Dominiak
    email = griwes@griwes.info

[alias]
    ri = rebase -i --autosquash
    mri = rebase -i
    fix = commit --fixup
    squ = commit --squash
    d = difftool

[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = /home/griwes/.ssh/allowed_signers
    defaultKeyCommand = bash -c 'ssh-add -L | xargs -I{} echo "key::{}"'
[commit]
	gpgsign = true
[tag]
    gpgsign = true

[difftool "difftastic"]
    # See `man git-difftool` for a description of MERGED, LOCAL and REMOTE.
    cmd = difft "$MERGED" "$LOCAL" "abcdef1" "100644" "$REMOTE" "abcdef2" "100644"
[difftool]
    prompt = false
[pager]
    difftool = true
[diff]
    external = difft
    tool = difftastic

[push]
    default = simple
[pull]
	ff = only
[init]
	defaultBranch = main
[rerere]
	enabled = true
[fetch]
	writeCommitGraph = true

