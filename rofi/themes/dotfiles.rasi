/*
 * Local rofi theme for this dotfiles repo.
 *
 * Clean-room approximation of the previously used rounded dark-gray look:
 * centered, compact, rounded, monochrome, and intentionally not copied from
 * the external GPL rofi theme collection.
 */

* {
    bg: #202226f2;
    panel: #2b2e33;
    overlay: #3a3e45cc;
    selected: #676d76;
    fg: #e2e4e7;
    quiet: #9a9fa8;
    placeholder: #5a6069;

    background-color: transparent;
    text-color: @fg;

    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    width: 480px;
    border: 0;
    border-radius: 24px;
    background-color: @bg;
}

mainbox {
    padding: 12px;
    background-color: transparent;
}

inputbar {
    children: [prompt, entry];
    spacing: 8px;
    padding: 8px 16px;
    border: 2px;
    border-radius: 16px;
    border-color: @selected;
    background-color: @panel;
}

prompt {
    text-color: @quiet;
}

entry {
    text-color: @fg;
    placeholder: "Search";
    placeholder-color: @placeholder;
}

message {
    margin: 12px 0 0;
    border: 1px;
    border-radius: 16px;
    border-color: @overlay;
    background-color: @overlay;
}

textbox {
    padding: 8px 24px;
    text-color: @fg;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    margin: 12px 0 0;
    background-color: transparent;
}

element {
    padding: 8px 16px;
    spacing: 8px;
    border-radius: 16px;
    background-color: transparent;
    text-color: @fg;
}

element normal active,
element alternate active {
    text-color: @selected;
}

element selected normal,
element selected active {
    background-color: @selected;
    text-color: @fg;
}

element-icon {
    size: 1em;
    vertical-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}
