#!/usr/bin/env bash

set -euo pipefail

# Give amixer a moment to publish the new value.
sleep 0.05

icon_dir="${HOME}/.config/i3/icons"
status="$(amixer sget Master)"
volume="$(
    awk -F'[][]' '/%/ { gsub(/%/, "", $2); print $2; exit }' <<<"${status}"
)"
state="$(
    awk -F'[][]' '/Playback/ && ($4 == "on" || $4 == "off") { print $4; exit }' <<<"${status}"
)"

if [[ "${state}" == "off" ]]; then
    notify-send -r 2101 -t 1000 -i "${icon_dir}/vol-mute.png" "Mute"
    exit 0
fi

if ((volume == 0)); then
    icon="${icon_dir}/vol-mute.png"
elif ((volume < 33)); then
    icon="${icon_dir}/vol-low.png"
elif ((volume < 67)); then
    icon="${icon_dir}/vol-med.png"
else
    icon="${icon_dir}/vol-high.png"
fi

notify-send -r 2101 -t 1000 -i "${icon}" "Volume: ${volume:-?}%"
