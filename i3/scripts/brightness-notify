#!/usr/bin/env bash

set -euo pipefail

# Give brightnessctl a moment to publish the new value.
sleep 0.05

icon="${HOME}/.config/i3/icons/brightness-icon.png"
brightness="$(
    brightnessctl -m 2>/dev/null |
        awk -F, '{ gsub(/%/, "", $4); print $4; exit }'
)"

notify-send \
    -r 2100 \
    -t 1000 \
    -i "${icon}" \
    "Brightness: ${brightness:-?}%"
